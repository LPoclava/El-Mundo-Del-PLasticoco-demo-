# Copiar este archivo como .env.local y completar con los datos de TU proyecto de Supabase
# (Project Settings > API). No subir .env.local a ningún repositorio.

# URL del proyecto, por ejemplo https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave PÚBLICA (anon / publishable). NUNCA poner acá la clave service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dirección pública del sitio una vez publicado (dominio real, con https://).
# Se usa en los enlaces canónicos, la vista previa al compartir (WhatsApp, redes) y el enlace del mensaje de consulta.
# Configurarla también en Vercel (Settings > Environment Variables). Si falta, en Vercel se usa el dominio de
# producción que informa la plataforma y en otros entornos esos enlaces se omiten: nunca se publica localhost.
NEXT_PUBLIC_SITE_URL=
