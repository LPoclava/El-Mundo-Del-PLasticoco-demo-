# Copiar este archivo como .env.local y completar con los datos de TU proyecto de Supabase
# (Project Settings > API). No subir .env.local a ningún repositorio.

# URL del proyecto, por ejemplo https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave PÚBLICA (anon / publishable). NUNCA poner acá la clave service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
