# Copiar este archivo como .env.local y completar con los datos de TU proyecto de Supabase
# (Project Settings > API). No subir .env.local a ningún repositorio.

# URL del proyecto, por ejemplo https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave PÚBLICA (anon / publishable). NUNCA poner acá la clave service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dirección pública del sitio una vez publicado (dominio real, con https://).
# Se usa en los enlaces canónicos, la vista previa al compartir (WhatsApp, redes) y el enlace del mensaje de consulta.
# Configurarla también en Vercel (Settings > Environment Variables). Si falta, en Vercel se usa el dominio de
# producción que informa la plataforma y en otros entornos esos enlaces se omiten: nunca se publica localhost.
NEXT_PUBLIC_SITE_URL=

# Solo desarrollo (no se usa en producción): direcciones desde las que se puede abrir el servidor local, separadas por
# comas. Sirve para probar desde el celular en la misma red Wi-Fi, por ejemplo ALLOWED_DEV_ORIGINS=192.168.1.50
# Si el router cambia la IP de la PC, se actualiza acá. Vacía por defecto.
ALLOWED_DEV_ORIGINS=

# ---- Circuito fiscal (ARCA): SOLO SERVIDOR. Nunca con el prefijo NEXT_PUBLIC_, nunca en el repositorio. ----
# La emisión fiscal NO está implementada ni habilitada. Estas variables se completan recién cuando existan el certificado
# de ARCA y los datos fiscales confirmados (ver docs/comprobantes.md). Configurarlas en Vercel como variables de servidor.
FISCAL_ARCA_CUIT=
FISCAL_ARCA_POINT_OF_SALE=
FISCAL_ARCA_CERT=
FISCAL_ARCA_KEY=
# homologacion (por defecto) o produccion
FISCAL_ARCA_ENV=homologacion
# Llave de producción de ESTE lado; además hace falta fiscal_settings.production_enabled en la base. Dejar vacía.
FISCAL_PRODUCTION_ALLOWED=
